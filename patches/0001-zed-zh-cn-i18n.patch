+fn remap_positions(text: &str, positions: &[usize]) -> Vec<usize> {
+    let mut out: Vec<usize> = positions
+        .iter()
+        .copied()
+        .filter(|&ix| text.is_char_boundary(ix))
+        .collect();
+    out.dedup();
+    out
+}
+
+fn search_candidate(ix: usize, command: &Command) -> StringMatchCandidate {
+    StringMatchCandidate::new(ix, &search_text(command))
+}

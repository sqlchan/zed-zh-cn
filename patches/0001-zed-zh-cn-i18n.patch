+//! Zed 界面汉化（i18n）模块。
+//!
+//! # 设计目标
+//!
+//! Zed 上游没有任何 UI 本地化框架，界面文案全部硬编码英文。本模块提供一层
+//! 轻量的「运行时字典」，让汉化**只依赖框架层的少数几个改动点**，业务代码零改动。
+//!
+//! 这样设计的原因：Zed 上游更新频繁，任何散落在业务代码里的改动都会在
+//! `git pull` 后产生冲突。把全部逻辑和译文收敛到本文件 + 词典数据文件 +
+//! `Label::new`，升级时冲突面最小。
+//!
+//! # 词典放在哪里
+//!
+//! 译文全部在仓库根的 `localization/i18n_dict.tsv`，格式为 `英文原文<TAB>中文译文`。
+//! 用 `include_str!` 嵌进二进制，启动时解析成哈希表。**新增译文只需要编辑那个
+//! 纯文本文件**，不必碰 Rust 代码，也就不会因为转义、引号写错而编译失败。
+//!
+//! 词典刻意放在 crate 之外：汉化涉及的所有东西——两个词典、扫描/打包脚本、
+//! 说明文档——都在 `localization/` 一个目录里，`git pull` 后一眼能看清自己改了
+//! 什么，升级时也只需要看那一处。代价是 `crates/ui` 不再是自包含的 crate
+//! （`cargo package` 会失败），本项目是 fork、不发布，可以接受。
+//!
+//! # 接入点
+//!
+//! 界面文案绝大多数最终都会经由 [`crate::Label::new`] 渲染（`Button`、菜单项、
+//! 设置项、面板标题等在内部都调用它），因此在那一处查表即可覆盖大部分 UI。
+//! [`crate::HighlightedLabel`] 覆盖命令面板等带高亮的列表项。
+//!
+//! # 只翻译「静态字面量」，不动用户数据
+//!
+//! 字典是**完整字符串精确匹配**，不分子串、不做模糊匹配。文件名、提交信息、
+//! 搜索结果等运行时数据几乎不可能恰好等于某个 UI 短语，因此不会被误译。
+//!
+//! # 动态拼接文案：模板
+//!
+//! 上游有大量文案是在渲染时才拼出来的（`format!("Close {} Dock", pos)`），
+//! 精确匹配永远命中不了。这类文案在 TSV 里写成含 `{}` 的**模板**，
+//! 例如 `Close {} Dock<TAB>关闭{}停靠栏`，匹配时把占位符位置的原样内容
+//! 填回去。同样是「只加数据、不改代码」，且以后上游新增同类文案只需加一行。
+
+use std::borrow::Cow;
+use std::collections::HashMap;
+use std::sync::OnceLock;
+
+/// 词典数据文件。每行 `英文原文<TAB>中文译文`，`#` 开头为注释。
+///
+/// 放在仓库根的 `localization/` 下（与脚本、文档同处一个目录），跨 crate 引用。
+const DICT_TSV: &str = include_str!("../../../localization/i18n_dict.tsv");
+
+/// 命令面板专用词典，见 [`translate_command_name`]。
+const COMMAND_DICT_TSV: &str = include_str!("../../../localization/i18n_commands.tsv");
+
+/// 界面语言。
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum UiLanguage {
+    /// 英文，不做任何替换。
+    English,
+    /// 简体中文。
+    Chinese,
+}
+
+static LANGUAGE: OnceLock<UiLanguage> = OnceLock::new();
+
+/// 返回当前界面语言。结果只计算一次并缓存。
+///
+/// 判定优先级：
+/// 1. 环境变量 `ZED_UI_LANGUAGE`（`en` / `zh` / `zh-CN` 均可）；
+/// 2. 系统区域设置（Windows 中文系统自动为中文）；
+/// 3. 兜底为英文。
+pub fn ui_language() -> UiLanguage {
+    *LANGUAGE.get_or_init(|| {
+        if let Ok(value) = std::env::var("ZED_UI_LANGUAGE") {
+            return if is_chinese_locale(&value) {
+                UiLanguage::Chinese
+            } else {
+                UiLanguage::English
+            };
+        }
+
+        match sys_locale::get_locale() {
+            Some(locale) if is_chinese_locale(&locale) => UiLanguage::Chinese,
+            _ => UiLanguage::English,
+        }
+    })
+}
+
+/// 当前是否启用中文界面。
+#[inline]
+pub fn is_chinese() -> bool {
+    ui_language() == UiLanguage::Chinese
+}
+
+fn is_chinese_locale(locale: &str) -> bool {
+    locale.to_ascii_lowercase().starts_with("zh")
+}
+
+/// 把界面英文文案翻译为中文。
+///
+/// 命中返回中文（静态词条零拷贝借用，模板词条返回新串）；
+/// 未命中或未启用中文时返回 `None`，调用方应保留原文。
+#[inline]
+pub fn translate(text: &str) -> Option<Cow<'static, str>> {
+    if !is_chinese() {
+        return None;
+    }
+    lookup(text)
+}
+
+/// [`translate`] 的 `SharedString` 版本。
+///
+/// 未命中时原样返回，不做多余分配。
+pub fn translate_owned(text: gpui::SharedString) -> gpui::SharedString {
+    match translate(text.as_ref()) {
+        Some(zh) => gpui::SharedString::from(zh),
+        None => text,
+    }
+}
+
+/// 给已经翻译过的显示文案补上英文原文，组成「中英双语」搜索串。
+///
+/// 汉化后界面上显示的是中文，但用户仍然会按英文名去搜，所以命令面板交给
+/// 模糊匹配的串必须是 `中文译文 英文原文`。[`translate_command_name`] 命中的
+/// 命令名传入这里即可两种语言都搜得到。
+///
+/// 未启用中文或没命中词条时返回 `None`，调用方沿用原文——特别注意**不要**把
+/// 「已经是用户数据」的串传进来再拼一遍，重复拼接没有意义。
+pub fn bilingual_search_text(display: &str, english: &str) -> Option<String> {
+    if !is_chinese() || display == english {
+        return None;
+    }
+    Some(format!("{display} {english}"))
+}
+
+/// 翻译命令面板里的命令显示名（形如 `editor: add selection above`）。
+///
+/// 这类名字由 action 的类型名自动推导而来（`humanize_action_name`），
+/// 源码里根本没有对应字面量，无法纳入通用词典扫描。译文放在
+/// [`COMMAND_DICT_TSV`] 里，**刻意与通用词典分开**：命令名由单个小写单词组成
+/// （`editor`、`copy`、`cancel`），若混进通用词典，项目面板里同名的文件或
+/// 文件夹会被一并译成中文。本函数拿到的必定是 action 名，不存在这个风险。
+pub fn translate_command_name(display_name: &str) -> Option<&'static str> {
+    if !is_chinese() {
+        return None;
+    }
+    command_dict().get(display_name).copied()
+}
+
+/// 命令面板词典（惰性构建，全进程一份）。
+fn command_dict() -> &'static HashMap<&'static str, &'static str> {
+    static COMMANDS: OnceLock<HashMap<&'static str, &'static str>> = OnceLock::new();
+    COMMANDS.get_or_init(|| {
+        let mut map = HashMap::new();
+        for line in COMMAND_DICT_TSV.lines() {
+            let line = line.trim_end_matches('\r');
+            if line.is_empty() || line.starts_with('#') {
+                continue;
+            }
+            let Some((en, zh)) = line.split_once('\t') else {
+                debug_assert!(false, "i18n_commands.tsv 缺少制表符: {line}");
+                continue;
+            };
+            if map.insert(en, zh).is_some() {
+                debug_assert!(false, "i18n_commands.tsv 词条重复: {en}");
+            }
+        }
+        map
+    })
+}
+
+/// 英文原文到中文译文的字典（惰性构建，全进程一份）。
+fn dict() -> &'static HashMap<&'static str, &'static str> {
+    static DICT: OnceLock<HashMap<&'static str, &'static str>> = OnceLock::new();
+    DICT.get_or_init(|| {
+        let mut map = HashMap::new();
+        for line in DICT_TSV.lines() {
+            let line = line.trim_end_matches('\r');
+            if line.is_empty() || line.starts_with('#') {
+                continue;
+            }
+            let Some((en, zh)) = line.split_once('\t') else {
+                debug_assert!(false, "i18n_dict.tsv 缺少制表符: {line}");
+                continue;
+            };
+            if map.insert(en, zh).is_some() {
+                debug_assert!(false, "i18n_dict.tsv 词条重复: {en}");
+            }
+        }
+        map
+    })
+}
+
+fn lookup(text: &str) -> Option<Cow<'static, str>> {
+    let dict = dict();
+    if let Some(zh) = dict.get(text) {
+        return Some(Cow::Borrowed(zh));
+    }
+
+    // 有些调用点会先 to_ascii_uppercase() 再渲染（如欢迎页的分组标题
+    // "Get Started" → "GET STARTED"），这里用大写形式再查一次。
+    // 只在原文含小写字母时才需要（已是大写的串上面就命中了）。
+    if text.bytes().any(|b| b.is_ascii_lowercase()) {
+        let upper = upper_dict();
+        if let Some(zh) = upper.get(text) {
+            return Some(Cow::Borrowed(zh));
+        }
+    }
+
+    template_match(text)
+}
+
+/// 大写形式的词典，供 `to_ascii_uppercase()` 后的调用点回退命中。
+fn upper_dict() -> &'static HashMap<String, &'static str> {
+    static UPPER: OnceLock<HashMap<String, &'static str>> = OnceLock::new();
+    UPPER.get_or_init(|| {
+        dict().iter()
+            .filter(|(en, _)| en.bytes().any(|b| b.is_ascii_lowercase()))
+            .map(|(en, zh)| (en.to_ascii_uppercase(), *zh))
+            .collect()
+    })
+}
+
+/// 模板词条：形如 `Close {} Dock` → `关闭{}停靠栏`。
+struct Template {
+    /// 以 `{}` 切分后的原文片段，比占位符多一个。
+    parts: Vec<&'static str>,
+    zh: &'static str,
+}
+
+static TEMPLATES: OnceLock<Vec<Template>> = OnceLock::new();
+
+/// 词典里所有含 `{}` 的词条，按占位符个数降序（更具体的优先匹配）。
+fn templates() -> &'static [Template] {
+    TEMPLATES.get_or_init(|| {
+        let mut list: Vec<Template> = dict()
+            .iter()
+            .filter(|(en, _)| en.contains("{}"))
+            .map(|(en, zh)| Template {
+                parts: en.split("{}").collect(),
+                zh,
+            })
+            .collect();
+        list.sort_by_key(|t| std::cmp::Reverse(t.parts.len()));
+        list
+    })
+}
+
+/// 用模板匹配动态拼接出来的文案，未命中返回 `None`。
+fn template_match(text: &str) -> Option<Cow<'static, str>> {
+    templates()
+        .iter()
+        .find_map(|tpl| match_parts(text, &tpl.parts).map(|values| (tpl, values)))
+        .map(|(tpl, values)| Cow::Owned(fill_template(tpl.zh, &values)))
+}
+
+/// 判断 `text` 是否形如 `parts[0] + 任意 + parts[1] + ...`，
+/// 是则返回各占位符位置的原样内容（借用 `text`，不分配）。
+fn match_parts<'a>(text: &'a str, parts: &[&str]) -> Option<Vec<&'a str>> {
+    let placeholders = parts.len().checked_sub(1)?;
+    if placeholders == 0 {
+        return None;
+    }
+
+    let mut values = Vec::with_capacity(placeholders);
+    let mut rest = text.strip_prefix(parts[0])?;
+
+    // 中间片段：逐个查找，前一段到它之间的内容就是占位符的值。
+    for part in &parts[1..placeholders] {
+        let idx = rest.find(part)?;
+        values.push(&rest[..idx]);
+        rest = &rest[idx + part.len()..];
+    }
+
+    // 末尾片段必须恰好收尾，避免把更长的句子误配。
+    let tail = rest.strip_suffix(parts[placeholders])?;
+    values.push(tail);
+    Some(values)
+}
+
+/// 把原文片段填回译文的 `{}` 位置。
+fn fill_template(zh: &str, values: &[&str]) -> String {
+    let mut out = String::with_capacity(zh.len() + values.iter().map(|v| v.len()).sum::<usize>());
+    let mut values = values.iter();
+    for (i, part) in zh.split("{}").enumerate() {
+        if i > 0 {
+            out.push_str(values.next().copied().unwrap_or(""));
+        }
+        out.push_str(part);
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn locale_detection() {
+        assert!(is_chinese_locale("zh-CN"));
+        assert!(is_chinese_locale("zh-Hans"));
+        assert!(is_chinese_locale("ZH"));
+        assert!(!is_chinese_locale("en-US"));
+        assert!(!is_chinese_locale("ja-JP"));
+    }
+
+    #[test]
+    fn dict_is_well_formed() {
+        // 词典已解析且非空
+        assert!(dict().len() > 100, "词典条目异常少：{}", dict().len());
+        // 键值都不应为空白
+        for (en, zh) in dict() {
+            assert!(!en.trim().is_empty(), "存在空的英文原文");
+            assert!(!zh.trim().is_empty(), "词条 {en:?} 的译文为空");
+            assert!(!en.contains('\t'), "英文原文含制表符: {en:?}");
+        }
+    }
+
+    #[test]
+    fn lookup_menus() {
+        assert_eq!(lookup("File").as_deref(), Some("文件"));
+        assert_eq!(lookup("Open Folder...").as_deref(), Some("打开文件夹…"));
+        assert_eq!(lookup("Zoom In").as_deref(), Some("放大"));
+        // 有些调用点先 to_ascii_uppercase() 再渲染，应能回退命中
+        assert_eq!(lookup("GET STARTED").as_deref(), Some("快速开始"));
+        assert_eq!(lookup("Get Started").as_deref(), Some("快速开始"));
+        // 用户数据不应命中字典（即使内容恰好是英文单词）
+        assert_eq!(lookup("main.rs"), None);
+        assert_eq!(lookup("src"), None);
+        assert_eq!(lookup("open"), None);
+    }
+
+    #[test]
+    fn lookup_templates() {
+        let t = |s: &str| lookup(s).map(|v| v.into_owned());
+
+        // 高频组合有精确词条，优先于模板命中，结果更通顺
+        assert_eq!(t("Close Left Dock").as_deref(), Some("关闭左侧停靠栏"));
+        assert_eq!(t("Close Right Dock").as_deref(), Some("关闭右侧停靠栏"));
+        assert_eq!(t("Toggle Changes Tab").as_deref(), Some("切换「更改」标签页"));
+        assert_eq!(t("Stage Folder").as_deref(), Some("暂存文件夹"));
+
+        // 未单独收录的组合走模板：变量原样保留（用户数据不翻译）
+        assert_eq!(t("Close Foo Dock").as_deref(), Some("关闭Foo停靠栏"));
+        assert_eq!(t("New Rust Thread").as_deref(), Some("新建Rust会话"));
+
+        // 模板不能过度匹配：前缀相同但结尾不同时不应命中
+        assert_eq!(t("Close Left Dock and More"), None);
+        assert_eq!(t("Close Left Docky"), None);
+        assert_eq!(t("This is a Dock"), None);
+    }
+
+    #[test]
+    fn bilingual_search_text_keeps_both_languages() {
+        // 汉化后界面上是中文，但用户仍会按英文名搜索，
+        // 所以匹配串必须中英都含。
+        let s = bilingual_search_text("编辑器: 在上方添加光标", "editor: add selection above")
+            .expect("译文与原文不同，应拼接");
+        assert!(s.contains("在上方添加光标"), "应含中文: {s}");
+        assert!(s.contains("editor: add selection above"), "应含英文原文: {s}");
+
+        // 没有译文（显示串与原文相同）时不拼接，避免无谓分配
+        assert_eq!(bilingual_search_text("main.rs", "main.rs"), None);
+    }
+
+    #[test]
+    fn command_names_use_their_own_dictionary() {
+        // 命令名单独成典，查表拿到的就是完整译文
+        assert_eq!(
+            translate_command_name("editor: add selection above"),
+            Some("编辑器: 在上方添加光标")
+        );
+        // 未收录的整条命令不翻译（宁可保持英文，也不出中英混排）
+        assert_eq!(translate_command_name("editor: this command does not exist"), None);
+        assert_eq!(translate_command_name("no such namespace: copy"), None);
+        // 不是命令名格式的串一概不碰
+        assert_eq!(translate_command_name("main.rs"), None);
+    }
+
+    #[test]
+    fn command_dictionary_never_leaks_into_the_ui_dictionary() {
+        // 命令名由单个小写单词组成（editor / copy / cancel），一旦混进通用词典，
+        // 项目面板里同名的文件或文件夹就会被译成中文。这条测试把它钉死。
+        for key in ["editor", "copy", "cancel", "outline", "search", "terminal", "task"] {
+            assert!(
+                dict().get(key).is_none(),
+                "{key:?} 不应出现在通用词典里（会误译同名文件）"
+            );
+        }
+        // 反向确认：同一个词在命令词典里是存在的，即分离确实生效了
+        assert!(
+            command_dict()
+                .keys()
+                .any(|k| k.starts_with("editor: ")),
+            "命令词典应包含 editor 命名空间的条目"
+        );
+    }
+
+    #[test]
+    fn translate_owned_matches_lookup() {
+        // Tooltip 标题、Label::set_text 都走这条路径，与 lookup 必须一致
+        assert_eq!(
+            translate_owned("Close Right Dock".into()).as_ref(),
+            "关闭右侧停靠栏"
+        );
+        assert_eq!(translate_owned("Toggle Changes Tab".into()).as_ref(), "切换「更改」标签页");
+        // 未命中原样返回
+        assert_eq!(translate_owned("config.py".into()).as_ref(), "config.py");
+    }
+
+    #[test]
+    fn template_parts_split_on_placeholder() {
+        let parts: Vec<&str> = "Close {} Dock".split("{}").collect();
+        assert_eq!(parts, vec!["Close ", " Dock"]);
+
+        let values = match_parts("Close Left Dock", &parts).expect("应匹配");
+        assert_eq!(values, vec!["Left"]);
+
+        // 两个占位符
+        let parts2: Vec<&str> = "Moved {} to {}".split("{}").collect();
+        let values2 = match_parts("Moved a.txt to b.txt", &parts2).expect("应匹配");
+        assert_eq!(values2, vec!["a.txt", "b.txt"]);
+
+        // 多个分隔符时按第一个切分，剩余部分整体作为末段
+        let values3 = match_parts("Moved to/x to y", &parts2).expect("应匹配");
+        assert_eq!(values3, vec!["to/x", "y"]);
+
+        // 不含占位符的模板不参与匹配
+        assert_eq!(match_parts("File", &["File"]), None);
+        // 前缀不符
+        assert_eq!(match_parts("Open Left Dock", &parts), None);
+    }
+}
